/*
 * PORT STRUCTURE FOR BURSTS:
 * PORTA:: (-, -, 40, 39, -, -, -, -, 8, 7, 6, 5, 4, -, -, -)
 * PORTB:: (36, 35, 34, -, -, -, -, -, -, -, -, 24, 23, 22, 21)
 * PORTC:: (-, -, -, -, 38, 37, 12, 11, 10, 9, 3, 2, 1, -, -, - )
 * PORTD:: (41, 42, 43, 44, 45, 46, 47, 48, 20, 19, 18, 17, 16, 15, 14, 13)
 * PORTE:: (-, -, -, -, -, -, -, 33, 32, 31, 30, 29, 28, 27, 26, 25)
 *
 *
 * BUFFER :: (41, 42, 43, 44, 45, 46, 47, 48, 20, 19, 18, 17, 16, 15, 14, 13) ( 38, 37, 12, 11, 10, 9, 3, 2, 1 )  (33, 32, 31, 30, 29, 28, 27, 26, 25) (36, 35, 34, 24, 23, 22, 21) ( 40, 39, 8, 7, 6, 5, 4)
 *
 * TABLE ::  (25, 24, 23, 48, 47, 46, 45, 44, 22, 21, 20, 19, 16, 15, 14, 13, 12, 11, 10,  9, 41, 40, 39, 38, 34, 33, 32, 31, 30, 29, 28, 27, 26, 37, 36, 35, 18, 17, 43, 42, 1,  2,  3,  4,  5,  6,  7,  8)
 */
constexpr std::array<uint16_t, 48> GRID::table;

void GRID::bufferWrite(uint8_t g, uint8_t r, uint8_t b, uint8_t i, uint8_t j){
	std::string s = "called write";
	std::string msg = "";
	char str[100];

	println(s);
	panelSelect(i, j);
	uint8_t bSelect = bitSelect(i);
	uint8_t base = bSelect/16;
	uint8_t word = base;
	uint8_t bit = bSelect%16;
	// Writing g
	for(int i=0; i<8; i++){
		this->panel[j][word] = (((g>>i)&(0x01)) << (15-bit));
		sprintf(str, "g: %x | r: %x | b: %x | i: %d | j: %d | bit: %d | word: %d | bSelect: %d | writting: %X",g, r, b, i, j, bit, word, bSelect, this->panel[j][word]);
		msg = str;
		println(msg);
		word = i*3 + base;
	}
	j++;
	// Writing r
	for(int i=0; i<8; i++){
		this->panel[j][word] = (((r>>i)&(0x01)) << (15-bit));
		sprintf(str, "g: %x | r: %x | b: %x | i: %d | j: %d | bit: %d | word: %d | bSelect: %d | writting: %X",g, r, b, i, j, bit, word, bSelect, this->panel[j][word]);
		msg = str;
		println(msg);
		word = i*3 + base;
	}
	j++;
	// Writing b
	for(int i=0; i<8; i++){
		this->panel[j][word] = (((b>>i)&(0x01)) << (15-bit));
		sprintf(str, "g: %x | r: %x | b: %x | i: %d | j: %d | bit: %d | word: %d | bSelect: %d | writting: %X",g, r, b, i, j, bit, word, bSelect, this->panel[j][word]);
		msg = str;
		println(msg);
		word = i*3 + base;
	}
	this->printGrid();
}


void GRID::printGrid(){
	std::string s = "";
	std::string msg = "";

	for(int i=0; i<48*3; i++){
		for(int j=0; j<3*8; j++){
			char str[30];
			sprintf(str, "%X", this->panel[i][j]);
			s = str;
			msg.append(s +  ", ");
		}
		println(msg);
		msg.clear();
	}
}
