uint8_t GRID::panelSelect(uint8_t i, uint8_t j){
	uint8_t i_ = i/PANEL_W;
	uint8_t j_ = j/PANEL_H;
	uint8_t panelCode = 0x00 | i_ | (j_ << 1);

	switch (panelCode){
		case panel_1_opcode:
			this->panel = this->panel_1;
		case panel_2_opcode:
			this->panel = this->panel_2;
		case panel_3_opcode:
			this->panel = this->panel_3;
		case panel_4_opcode:
			this->panel = this->panel_4;
	}


	return panelCode;


}






