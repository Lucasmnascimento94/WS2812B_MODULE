#include "Print.hpp"
#include "stm32h5xx_hal.h"


PrintUart::PrintUart(UART_HandleTypeDef *huart, uint8_t mode)
:	huart(huart),
	mode(mode)
{
	// Set Up printing based on mode configuration.
	HAL_UART_Init(this->huart);
}


void PrintUart::println(std::string &str){
	// Send data out

	int len = str.size();
	HAL_UART_Transmit(this->huart, (uint8_t *)str.c_str(),len,1000);
	HAL_UART_Transmit(this->huart, (uint8_t *)"\n", 1, 1000);
}
