static inline void wait_ticks(uint32_t dt)
{
    uint32_t start = TIM2->CNT;
    while ((uint32_t)(TIM2->CNT - start) < dt) {
        __NOP();
    }
}


void MX_TIM2_Init(void)
{
	RCC->APB1LENR |= RCC_APB1LENR_TIM2EN;

	TIM2->CNT = 0;
	TIM2->PSC = 0;
	TIM2->ARR = 0x10;
	TIM2->CR1 |= TIM_CR1_ARPE | TIM_CR1_CEN;
	TIM2->DIER |= TIM_DIER_UIE;
	NVIC_EnableIRQ(TIM2_IRQn);
}

void TIM2_IRQHandler(void)
{
	static uint8_t count = 0;
    if (TIM2->SR & TIM_SR_UIF) {    // check update flag
        TIM2->SR &= ~TIM_SR_UIF;    // clear it (mandatory!)

        //const uint32_t color = 0x00FF00u;   // GRB: G=0xFF, R=0, B=0
        if(count == 150){count = 0; return;}
        // For each pixel in the chain
        if(count++ > 48) return;

        for (uint16_t i = 0; i < 24; ++i) {
            //GPIOD->BSRR = 0XFFFF;
        	//GPIOA->BSRR = 0XFFFF; // <0011 0000 1111 1000> <0x0C7C>
        	//GPIOC->BSRR = 0XFFFF; // <0000 1111 1111 1000> <0x0FF8>
        	//GPIOB->BSRR = 0XFFFF; // <1110 0000 0011 1100>  <0xE03C>
        	GPIOE->BSRR = 0XFFFF; // <0000 0001 1111 1111> <0x01FF>
        	NOP8();
        	NOP8();
        	NOP8();

        	if(i < 8){
        		//GPIOD->BSRR = 0XFFFF;
            	//GPIOA->BSRR = 0XFFFF0000; // <0011 0000 1111 1000> <0x0C7C>
            	//GPIOC->BSRR = 0XFFFF0000; // <0000 1111 1111 1000> <0x0FF8>
            	//GPIOB->BSRR = 0XFFFF; // <1110 0000 0011 1100>  <0xE03C>
            	GPIOE->BSRR = 0XFFFF0000; // <0000 0001 1111 1111> <0x01FF>
        	}
        	else if(i < 16){
        		//GPIOD->BSRR = 0XFFFF0000;
            	//GPIOA->BSRR = 0XFFFF; // <0011 0000 1111 1000> <0x0C7C>
            	//GPIOC->BSRR = 0XFFFF0000; // <0000 1111 1111 1000> <0x0FF8>
            	//GPIOB->BSRR = 0XFFFF0000; // <1110 0000 0011 1100>  <0xE03C>
            	GPIOE->BSRR = 0XFFFF; // <0000 0001 1111 1111> <0x01FF>
        	}
        	else{
        		//GPIOD->BSRR = 0XFFFF0000;
            	//GPIOA->BSRR = 0XFFFF0000; // <0011 0000 1111 1000> <0x0C7C>
            	//GPIOC->BSRR = 0XFFFF; // <0000 1111 1111 1000> <0x0FF8>
            	//GPIOB->BSRR = 0XFFFF; // <1110 0000 0011 1100>  <0xE03C>
            	GPIOE->BSRR = 0XFFFF; // <0000 0001 1111 1111> <0x01FF>
        	}
        	NOP32();

    		//GPIOD->BSRR = 0XFFFF0000;
        	//GPIOA->BSRR = 0XFFFF0000; // <0011 0000 1111 1000> <0x0C7C>
        	//GPIOC->BSRR = 0XFFFF0000; // <0000 1111 1111 1000> <0x0FF8>
        	//GPIOB->BSRR = 0XFFFF0000; // <1110 0000 0011 1100>  <0xE03C>
        	GPIOE->BSRR = 0XFFFF0000; // <0000 0001 1111 1111> <0x01FF>
        	NOP8();
        	NOP8();
        	NOP8();

        }
    }

}
