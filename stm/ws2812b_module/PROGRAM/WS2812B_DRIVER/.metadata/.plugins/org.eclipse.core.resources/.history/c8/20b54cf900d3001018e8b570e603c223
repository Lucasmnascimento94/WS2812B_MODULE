void GRID::writePanel(){

	std::array<std::array<uint16_t, 3*8>, 3*48> *panel = this->panel;
	for(int i = 0; i< 48; i++){
		for(int j = 0; j<24; j+=3){
			writeBits(&(*panel)[i][j], &(*panel)[i][j+1], &(*panel)[i][j+2]);
		}
	}


}
void GRID::displayGrid(){
	int i=0;
	int j=0;

	panelEnable(panelSelect(i, j));
	writePanel();

	i+=48;
	panelEnable(panelSelect(i, j));
	writePanel();

	i=0; j+=48;
	panelEnable(panelSelect(i, j));
	writePanel();

	i+=48;
	panelEnable(panelSelect(i, j));
	writePanel();

}
