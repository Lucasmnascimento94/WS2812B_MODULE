		(*this->panel)[j_][word] |= (((r>>i)&(0x01)) << (15-bit));
		//sprintf(str, "g: %x | r: %x | b: %x | i: %d | j: %d | bit: %d | word: %d | bSelect: %d | writting: %X",g, r, b, i, j, bit, word, bSelect, (*this->panel)[j_][word]);
