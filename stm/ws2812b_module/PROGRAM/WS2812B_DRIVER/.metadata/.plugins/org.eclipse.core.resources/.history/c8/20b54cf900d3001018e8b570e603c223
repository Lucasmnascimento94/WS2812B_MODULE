uint8_t GRID::busDetect(){
	if(HAL_GPIO_ReadPin(BUS_1_DETECT_GPIO_Port, BUS_1_DETECT_Pin)){
		n_panels++;

	}
	if(HAL_GPIO_ReadPin(BUS_2_DETECT_GPIO_Port, BUS_2_DETECT_Pin)){
		n_panels++;
	}
	if(HAL_GPIO_ReadPin(BUS_3_DETECT_GPIO_Port, BUS_3_DETECT_Pin)){
		n_panels++;
	}
	if(HAL_GPIO_ReadPin(BUS_4_DETECT_GPIO_Port, BUS_4_DETECT_Pin)){
		n_panels++;
	}

	return n_panels;
}

uint8_t GRID::bitSelect(uint8_t i){
	return this->table[i]-1;
}

uint8_t GRID::panelSelect(uint8_t i, uint8_t j){
	uint8_t i_ = i/PANEL_W;
	uint8_t j_ = j/PANEL_H;
	uint8_t panelCode = 0x00 | i_ | (j_ << 1);

	switch (panelCode){
		case panel_1_opcode: this->panel = &this->panel_1; break;
		case panel_2_opcode: this->panel = &this->panel_2; break;
		case panel_3_opcode: this->panel = &this->panel_3; break;
		case panel_4_opcode: this->panel = &this->panel_4; break;
	}
	return panelCode;
}

void GRID::panelEnable(uint8_t panel_code){
	switch (panel_code){
		case panel_1_opcode: confPanel_1(); break;
		case panel_2_opcode: confPanel_2(); break;
		case panel_3_opcode: confPanel_3(); break;
		case panel_4_opcode: confPanel_4(); break;
	}
}

void GRID::confPanel_1(){
	HAL_GPIO_WritePin(BUS_1_GPIO_Port, BUS_1_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(BUS_2_GPIO_Port, BUS_2_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(BUS_3_GPIO_Port, BUS_3_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(BUS_4_GPIO_Port, BUS_4_Pin, GPIO_PIN_SET);
}

