}


void GRID::printGrid(){
	std::string s = "";
	std::string msg = "";

	for(int i=0; i<48*3; i++){
		for(int j=0; j<3*8; j++){
			char str[30];
			sprintf(str, "%X", (*this->panel)[i][j]);
			s = str;
			msg.append(s +  ", ");
		}
		println(msg);
		msg.clear();
	}
}

