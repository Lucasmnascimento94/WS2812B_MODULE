uint8_t GRID::busDetect(){
	if(HAL_GPIO_ReadPin(BUS_1_DETECT_GPIO_Port, BUS_1_DETECT_Pin)) this->n_panels++;
	if(HAL_GPIO_ReadPin(BUS_2_DETECT_GPIO_Port, BUS_2_DETECT_Pin)) this->n_panels++;
	if(HAL_GPIO_ReadPin(BUS_3_DETECT_GPIO_Port, BUS_3_DETECT_Pin)) this->n_panels++;
	if(HAL_GPIO_ReadPin(BUS_4_DETECT_GPIO_Port, BUS_4_DETECT_Pin)) this->n_panels++;
	return n_panels;
}

void GRID::buffSelect(uint8_t panel_opcode, uint8_t port){
	if(port == portA){
		switch(panel_opcode){
			case panel_1_opcode: this->buff = panel_1A; return;
			case panel_2_opcode: this->buff = panel_2A; return;
			case panel_3_opcode: this->buff = panel_3A; return;
			default: this->buff = panel_4A; return;
		}
	} else if(port == portB){
		switch(panel_opcode){
			case panel_1_opcode: this->buff = panel_1B; return;
			case panel_2_opcode: this->buff = panel_2B; return;
			case panel_3_opcode: this->buff = panel_3B; return;
			default: this->buff = panel_4B; return;
		}
	} else if(port == portC){
		switch(panel_opcode){
			case panel_1_opcode: this->buff = panel_1C; return;
			case panel_2_opcode: this->buff = panel_2C; return;
			case panel_3_opcode: this->buff = panel_3C; return;
			default: this->buff = panel_4C; return;
		}
	} else if(port == portD){
		switch(panel_opcode){
			case panel_1_opcode: this->buff = panel_1D; return;
			case panel_2_opcode: this->buff = panel_2D; return;
			case panel_3_opcode: this->buff = panel_3D; return;
			default: this->buff = panel_4D; return;
		}
	} else{
		switch(panel_opcode){
			case panel_1_opcode: this->buff = panel_1E; return;
			case panel_2_opcode: this->buff = panel_2E; return;
			case panel_3_opcode: this->buff = panel_3E; return;
			default: this->buff = panel_4E; return;
		}
	}
}

uint8_t GRID::panelSelect(uint8_t i, uint8_t j){
	uint8_t i_ = i/PANEL_W;
	uint8_t j_ = j/PANEL_H;
	return 0x00 | i_ | (j_ << 1); // Return panel opcode
}






