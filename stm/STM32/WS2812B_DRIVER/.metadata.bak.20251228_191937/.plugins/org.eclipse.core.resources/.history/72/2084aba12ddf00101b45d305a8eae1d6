/*
 * Parameters: i->pixel position in the grid line. | j->pixel position in the grid column
 */
void GRID::pixelrWrite(uint8_t color[3], uint8_t i_, uint8_t j_){
	uint8_t g = color[0];
	uint8_t r = color[1];
	uint8_t b = color[2];

	uint16_t index = (j_ % 48) * JUMP;
	uint8_t bitSelect = toBit[i_];
	this->buffSelect(this->panelSelect(i_, j_), toPort[i_]);
	//std::string s = "i: " + std::to_string(i_) + " j: " + std::to_string(j_) + " bit: " + std::to_string(bitSelect) +" port: " + std::to_string(toPort[i_]) + " index: " + std::to_string(index) + " panel: " + std::to_string(this->panelSelect(i_, j_));
	// Writing g
	//println(s);
	for(int i=0; i<8; i++){
		if((g >> i) & 0x01){
			this->buff[index] |= (1<<bitSelect);
			this->buff[index] &= ~(1<<(bitSelect + 16));
		} else{
			this->buff[index] &= ~(1<<bitSelect);
			this->buff[index] |= (1<<(bitSelect + 16));
		}
		index++;
	}

	// Writing r
	for(int i=0; i<8; i++){
		if((r >> i) & 0x01){
			this->buff[index] |= (1<<bitSelect);
			this->buff[index] &= ~(1<<(bitSelect + 16));
		} else{
			this->buff[index] &= ~(1<<bitSelect);
			this->buff[index] |= (1<<(bitSelect + 16));
		}
		index++;
	}
	// Writing b
	for(int i=0; i<8; i++){
		if((b >> i) & 0x01){
			this->buff[index] |= (1<<bitSelect);
			this->buff[index] &= ~(1<<(bitSelect + 16));
		} else{
			this->buff[index] &= ~(1<<bitSelect);
			this->buff[index] |= (1<<(bitSelect + 16));
		}
		index++;
	}


}


void GRID::printGrid(uint8_t panel_opcode){
	std::string line;
	char c[100];
	switch (panel_opcode){
		case panel_1_opcode:
			this->buffA = panel_1A;
			this->buffB = panel_1B;
			this->buffC = panel_1C;
			this->buffD = panel_1D;
			this->buffE = panel_1E;
		case panel_2_opcode:
