GRID::GRID(){
	this->clear();
}
/*
 * Parameters: i->pixel position in the grid line. | j->pixel position in the grid column
 */
void GRID::clear(){
	this->clearPanel(panel_1_opcode);
	this->clearPanel(panel_2_opcode);
	this->clearPanel(panel_3_opcode);
	this->clearPanel(panel_4_opcode);
}

void GRID::clearPanel(uint8_t panel_opcode){
	this->buffPortSelect(panel_opcode);
	for(int i=0; i< SIZE; i++){
		this->buffA[i] = GRID_MASK_PORTA << 16;
		this->buffB[i] = GRID_MASK_PORTB << 16;
		this->buffC[i] = GRID_MASK_PORTC << 16;
		this->buffD[i] = GRID_MASK_PORTD << 16;
		this->buffE[i] = GRID_MASK_PORTE << 16;
	}
}
void GRID::pixelrWrite(uint8_t color[3], uint8_t i_, uint8_t j_){
	uint8_t g = color[0];
	uint8_t r = color[1];
	uint8_t b = color[2];

	uint16_t index = (j_ % 48) * JUMP;
	uint8_t bitSelect = toBit[i_];
	this->buffSelect(this->panelSelect(i_, j_), toPort[i_]);
	if(toPort[i_] == portE){
		std::string s = "i: " + std::to_string(i_) + " j: " + std::to_string(j_) + " bit: " + std::to_string(bitSelect) +" port: " + std::to_string(toPort[i_]) + " index: " + std::to_string(index) + " panel: " + std::to_string(this->panelSelect(i_, j_));
		println(s);
	}
	 Writing g
	for(int i=0; i<8; i++){
		if((g >> i) & 0x01){
			this->buff[index] |= (1<<bitSelect);
			this->buff[index] &= ~(1<<(bitSelect + 16));
		} else{
			this->buff[index] &= ~(1<<bitSelect);
			this->buff[index] |= (1<<(bitSelect + 16));
		}
		index++;
	}

	// Writing r
	for(int i=0; i<8; i++){
		if((r >> i) & 0x01){
			this->buff[index] |= (1<<bitSelect);
			this->buff[index] &= ~(1<<(bitSelect + 16));
		} else{
			this->buff[index] &= ~(1<<bitSelect);
			this->buff[index] |= (1<<(bitSelect + 16));
		}
		index++;
	}
	// Writing b
	for(int i=0; i<8; i++){
		if((b >> i) & 0x01){
			this->buff[index] |= (1<<bitSelect);
			this->buff[index] &= ~(1<<(bitSelect + 16));
		} else{
			this->buff[index] &= ~(1<<bitSelect);
			this->buff[index] |= (1<<(bitSelect + 16));
		}
		index++;
	}
}

void GRID::buffPortSelect(uint8_t panel_opcode){
	switch (panel_opcode){
		case panel_1_opcode:
			this->buffA = panel_1A;
			this->buffB = panel_1B;
			this->buffC = panel_1C;
			this->buffD = panel_1D;
			this->buffE = panel_1E;
			break;
		case panel_2_opcode:
			this->buffA = panel_2A;
			this->buffB = panel_2B;
			this->buffC = panel_2C;
			this->buffD = panel_2D;
			this->buffE = panel_2E;
			break;
		case panel_3_opcode:
			this->buffA = panel_3A;
			this->buffB = panel_3B;
			this->buffC = panel_3C;
			this->buffD = panel_3D;
			this->buffE = panel_3E;
			break;
		case panel_4_opcode:
			this->buffA = panel_4A;
			this->buffB = panel_4B;
			this->buffC = panel_4C;
			this->buffD = panel_4D;
			this->buffE = panel_4E;
			break;
	}
}

