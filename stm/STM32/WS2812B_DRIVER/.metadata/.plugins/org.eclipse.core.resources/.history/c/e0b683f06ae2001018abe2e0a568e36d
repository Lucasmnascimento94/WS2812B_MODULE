#include <print.hpp>
#include <string>
#include "stm32h5xx_hal.h"
#include "memory.hpp"

extern UART_HandleTypeDef huart4;

void print(std::string &str){
	// Send data out

	int len = str.size();
	HAL_UART_Transmit(&huart4, (uint8_t *)str.c_str(),len,1000);
}


void println(std::string &str){
	// Send data out

	int len = str.size();
	HAL_UART_Transmit(&huart4, (uint8_t *)str.c_str(),len,1000);
	HAL_UART_Transmit(&huart4, (uint8_t *)"\n", 1, 1000);
}

void printError(uint8_t err){
	std:string s = "Err:: ";
	switch (err){
		case MAXOUT: s += "MAXOUT"; println(s); break;
		case EMPTY_LIST: s += "EMPTY_LIST"; println(s); break;
	}
}
