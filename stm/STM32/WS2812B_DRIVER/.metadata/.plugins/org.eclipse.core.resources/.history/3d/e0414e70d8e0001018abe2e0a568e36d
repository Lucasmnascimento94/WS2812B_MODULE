/*
 * Translate from i,j to the actual connected PORT
 */
static const uint16_t toPort[48]{
    // Columns 0-7 (Logical 1-8): Port C then Port A
    portC, portC, portC, portA, portA, portA, portA, portA,
    // Columns 8-15 (Logical 9-16): Port C then Port D
    portC, portC, portC, portC, portD, portD, portD, portD,
    // Columns 16-23 (Logical 17-24): Port D then Port B
    portD, portD, portD, portD, portB, portB, portB, portB,
    // Columns 24-31 (Logical 25-32): Port E
    portE, portE, portE, portE, portE, portE, portE, portE,
    // Columns 32-39 (Logical 33-40): Port E, Port B, Port C, Port A
    portE, portB, portB, portB, portC, portC, portA, portA,
    // Columns 40-47 (Logical 41-48): Port D
    portD, portD, portD, portD, portD, portD, portD, portD
};

static const uint16_t toBit[48]{
    // 0-7: Matches images 724ccf (Port C) and 724cf0 (Port A)
    12, 11, 10, 12, 11, 10, 9, 8,
    // 8-15: Matches images 724ccf (Port C) and 70f427 (Port D)
    9, 8, 7, 6, 15, 14, 13, 12,
    // 16-23: Matches images 70f427 (Port D) and 724ceb (Port B)
    11, 10, 9, 8, 12, 13, 14, 15, // Fixed Port B order 21-24
    // 24-31: Matches image 724cac (Port E bits 15-8)
    15, 14, 13, 12, 11, 10, 9, 8,
    // 32-39: Transition point for logical 33-40
    7, 2, 1, 0, 5, 4, 3, 2,      // Bit 7 is E; 2,1,0 are B; 5,4 are C; 3,2 are A
    // 40-47: Matches image 70f427 (Port D bits 0-7)
    0, 1, 2, 3, 4, 5, 6, 7
};


