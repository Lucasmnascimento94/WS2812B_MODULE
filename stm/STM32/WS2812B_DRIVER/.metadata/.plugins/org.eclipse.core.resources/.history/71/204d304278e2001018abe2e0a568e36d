#define GRB_AQUA            0x00FF00FFvoid Snake::generateFood(){
	std::random_device r;
	std::mt19937 engine(r());
	std::uniform_int_distribution<int> dist(0, 47);

	while(true){
		uint8_t i = (uint8_t)dist(engine);
		uint8_t j = (uint8_t)dist(engine);

		if(this->map[i][j] == VOID){
			this->map[i][j] = FOOD;
			this->grid.pixelWrite(this->food_color, i, j);
		}
	}
}
