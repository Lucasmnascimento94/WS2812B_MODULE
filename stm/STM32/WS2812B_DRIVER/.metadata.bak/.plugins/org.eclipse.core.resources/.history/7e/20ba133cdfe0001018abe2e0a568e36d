void MX_TIM2_Init(void)
{
	RCC->APB1LENR |= RCC_APB1LENR_TIM2EN;

	TIM2->CNT = 0;
	TIM2->PSC = 0;
	TIM2->ARR = 2000;
	TIM2->CR1 |= TIM_CR1_ARPE | TIM_CR1_CEN;
	TIM2->DIER |= TIM_DIER_UIE;
	NVIC_EnableIRQ(TIM2_IRQn);
	confPanel_1();
}

void TIM2_IRQHandler(void)
{
	static uint8_t count = 0;
	static uint16_t index = 0;
	static uint8_t panel = panel_1_opcode;
    if (TIM2->SR & TIM_SR_UIF) {    // check update flag
        TIM2->SR &= ~TIM_SR_UIF;    // clear it (mandatory!)
        if(count%48 == 0) index = 0;

        if(count/48 == 0) 	   registerD(&index, panel);
        else if(count/48 == 1) registerB(&index, panel);
        else if(count/48 == 2) registerC(&index, panel);
        else if(count/48 == 3) registerA(&index, panel);
        else if(count/48 == 4){registerE(&index, panel);
        	if(count%48 == 47){
        		if(panel == panel_1_opcode){panel = panel_2_opcode; confPanel_2();}
        		else if(panel == panel_2_opcode){panel = panel_3_opcode; confPanel_3();}
        		else if(panel == panel_3_opcode){panel = panel_4_opcode; confPanel_4();}
        		else if(panel == panel_4_opcode){panel = panel_1_opcode; count = 0; confPanel_1(); return;}
        	}
        }
        count++;
    }
}

static inline void registerA(uint16_t *index, uint16_t panel){
	static uint32_t *buff;
	if(panel == panel_1_opcode)buff = panel_1A;
	else if(panel == panel_2_opcode)buff = panel_2A;
	else if(panel == panel_3_opcode)buff = panel_3A;
	else if (panel == panel_4_opcode)buff = panel_4A;
	else {*index += 24; return;}
    for (uint16_t i = 0; i < 24; ++i) {
        GPIOA->BSRR = GRID_MASK_PORTA;
    	NOP8();

    	GPIOA->BSRR = buff[*index] & 0x1F0C1F0C;
    	NOP32();


		GPIOA->BSRR = GRID_MASK_PORTA << 16;
    	NOP8();
    	(*index)++;
    }
}

