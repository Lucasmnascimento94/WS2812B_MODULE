uint8_t busDetect(){
	if(HAL_GPIO_ReadPin(BUS_1_DETECT_GPIO_Port, BUS_1_DETECT_Pin)){
		n_panels++;

	}
	if(HAL_GPIO_ReadPin(BUS_2_DETECT_GPIO_Port, BUS_2_DETECT_Pin)){
		n_panels++;
	}
	if(HAL_GPIO_ReadPin(BUS_3_DETECT_GPIO_Port, BUS_3_DETECT_Pin)){
		n_panels++;
	}
	if(HAL_GPIO_ReadPin(BUS_4_DETECT_GPIO_Port, BUS_4_DETECT_Pin)){
		n_panels++;
	}

	return n_panels;
}


uint32_t *panelSelect(uint8_t i, uint8_t j){
	uint8_t i_ = i/PANEL_W;
	uint8_t j_ = j/PANEL_H;

	uint8_t panelCode = 0x00 | i_ | (j_ << 1);

	switch (panelCode){
		case panel_1_opcode: panelEnable1(panel_1_opcode); break;
		case panel_2_opcode: panelEnable1(panel_2_opcode); break;
		case panel_3_opcode: panelEnable1(panel_3_opcode); break;
		case panel_4_opcode: panelEnable1(panel_4_opcode); break;
	}

	return portSelect(i%48, panelCode);
}

void panelEnable(uint8_t panel_code){
	switch (panel_code){
		case panel_1_opcode: confPanel_1(); break;
		case panel_2_opcode: confPanel_2(); break;
		case panel_3_opcode: confPanel_3(); break;
		case panel_4_opcode: confPanel_4(); break;
	}
}

uint32_t *portSelect(uint8_t i, uint8_t panel_code){
	if(panel_code == panel_1_opode){
		switch (toPort[i]){
			case portA: return panel_1A;
			case portB: return panel_1B;
			case portC: return panel_1C;
			case portD: return panel_1D;
			case portE: return panel_1E;
		}
	}
	else if(panel_code == panel_2_opode){
		switch (toPort[i]){
			case portA: return panel_2A;
			case portB: return panel_2B;
			case portC: return panel_2C;
			case portD: return panel_2D;
			case portE: return panel_2E;
		}
	}
	else if(panel_code == panel_3_opode){
		switch (toPort[i]){
			case portA: return panel_3A;
			case portB: return panel_3B;
			case portC: return panel_3C;
			case portD: return panel_3D;
			case portE: return panel_3E;
		}
	}
	else{
		switch (toPort[i]){
			case portA: return panel_4A;
			case portB: return panel_4B;
			case portC: return panel_4C;
			case portD: return panel_4D;
			case portE: return panel_4E;
		}
	}
}


